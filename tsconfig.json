{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"checkJs": false,
		"types": [
			"$app/types",
			"./worker-configuration.d.ts"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
